# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. In AWS these values come from Secrets Manager / the ECS task definition.

# Required header value for POST /predict (X-API-Key). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Optional overrides (defaults shown)
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=5242880
TOP_K=5
